---
import { getCollection } from 'astro:content';
import '../styles/global.css';  // <--- 加入這一行！

// 1. 獲取所有專案資料
const allProjects = await getCollection('projects');

// 2. 依照日期排序 (新到舊)
const sortedProjects = allProjects.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

// 3. 提取所有唯一的分類和標籤 (用於製作按鈕)
const categories = [...new Set(allProjects.map((p) => p.data.category))];
const allTags = [...new Set(allProjects.flatMap((p) => p.data.tags))];
---

<html lang="zh-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>積木 Jack | 作品集</title>
    <!-- 引入 Google Fonts 增加科技感 -->
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&family=Noto+Sans+TC:wght@300;500;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-slate-900 text-slate-100 font-['Noto_Sans_TC'] min-h-screen">
    
    <!-- Header -->
    <header class="border-b border-cyan-500/30 bg-slate-900/80 backdrop-blur-md sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center">
        <h1 class="text-3xl font-['Orbitron'] text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500 font-bold tracking-wider">
          BLOCK JACK
        </h1>
        <div class="text-xs text-cyan-400 border border-cyan-500/50 px-2 py-1 rounded">SYSTEM: ONLINE</div>
      </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 py-8">
      
      <!-- 控制面板 (搜尋與篩選) -->
      <section class="mb-10 bg-slate-800/50 p-6 rounded-xl border border-slate-700 shadow-lg backdrop-blur-sm">
        <h2 class="text-xl mb-4 font-['Orbitron'] text-cyan-300 flex items-center gap-2">
          <span class="w-2 h-2 bg-cyan-400 rounded-full animate-pulse"></span>
          FILTER_SYSTEM
        </h2>
        
        <!-- 分類按鈕 -->
        <div class="flex flex-wrap gap-3 mb-4" id="category-filters">
          <button class="filter-btn active px-4 py-1 bg-cyan-900/30 border border-cyan-500 text-cyan-300 rounded hover:bg-cyan-500 hover:text-white transition-all duration-300 text-sm" data-group="category" data-value="all">
            ALL
          </button>
          {categories.map((cat) => (
            <button class="filter-btn px-4 py-1 bg-slate-800 border border-slate-600 text-slate-400 rounded hover:border-cyan-400 hover:text-cyan-300 transition-all duration-300 text-sm" data-group="category" data-value={cat}>
              {cat}
            </button>
          ))}
        </div>

        <!-- 標籤雲 -->
        <div class="flex flex-wrap gap-2 items-center">
            <span class="text-xs text-slate-500 uppercase tracking-widest mr-2">Tags:</span>
            {allTags.map((tag) => (
              <button class="tag-filter text-xs px-2 py-1 bg-slate-700/50 rounded text-slate-400 hover:text-white hover:bg-slate-600 transition" data-value={tag}>
                #{tag}
              </button>
            ))}
        </div>
      </section>

      <!-- 作品網格 (Grid) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="project-grid">
        {sortedProjects.map((project) => (
          <article 
            class="project-card group relative bg-slate-800 rounded-xl overflow-hidden border border-slate-700 hover:border-cyan-500/50 transition-all duration-500 hover:shadow-[0_0_20px_rgba(6,182,212,0.15)]"
            data-category={project.data.category}
            data-tags={project.data.tags.join(',')}
            data-date={project.data.publishDate.toISOString()}
          >
            <!-- 圖片區 -->
            <div class="relative h-64 overflow-hidden">
              <img 
                  /* 這裡是最關鍵的修改！ */
                /* 邏輯：基本路徑 (/BuildingBlocks/) + 圖片路徑 (images/photo1.jpg) */
                src={import.meta.env.BASE_URL + project.data.image.replace(/^\//, '')} 
                alt={project.data.title} 
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-900 to-transparent opacity-60"></div>
              <div class="absolute top-2 right-2 bg-slate-900/80 backdrop-blur text-cyan-400 text-xs px-2 py-1 rounded border border-cyan-500/30">
                {project.data.category}
              </div>
            </div>

            <!-- 內容區 -->
            <div class="p-5">
              <div class="flex justify-between items-start mb-2">
                <h3 class="text-xl font-bold text-white group-hover:text-cyan-400 transition-colors">
                  {project.data.title}
                </h3>
              </div>
              
              <p class="text-slate-400 text-sm mb-4 line-clamp-2">
                {project.data.description}
              </p>

              <div class="flex flex-wrap gap-2 mt-auto">
                {project.data.tags.map((tag) => (
                  <span class="text-xs text-slate-500 bg-slate-900 px-2 py-1 rounded">#{tag}</span>
                ))}
              </div>
              
              <div class="mt-4 pt-4 border-t border-slate-700 flex justify-between items-center text-xs text-slate-500 font-mono">
                <span>DATALOG: {project.data.publishDate.toISOString().split('T')[0]}</span>
                <span class="group-hover:translate-x-1 transition-transform text-cyan-500">View Data &rarr;</span>
              </div>
            </div>
          </article>
        ))}
      </div>

    </main>

    <!-- Client-side Filtering Logic -->
    <script>
      // 簡單的客戶端篩選腳本
      const categoryBtns = document.querySelectorAll('.filter-btn');
      const tagBtns = document.querySelectorAll('.tag-filter');
      const cards = document.querySelectorAll('.project-card');

      function filterProjects(filterType, value) {
        // 重置樣式
        if (filterType === 'category') {
            categoryBtns.forEach(btn => {
                btn.classList.remove('bg-cyan-900/30', 'border-cyan-500', 'text-cyan-300', 'active');
                btn.classList.add('bg-slate-800', 'border-slate-600', 'text-slate-400');
                if((btn as HTMLElement).dataset.value === value) {
                    btn.classList.remove('bg-slate-800', 'border-slate-600', 'text-slate-400');
                    btn.classList.add('bg-cyan-900/30', 'border-cyan-500', 'text-cyan-300', 'active');
                }
            });
        }

        cards.forEach(card => {
          const cardCat = (card as HTMLElement).dataset.category;
          const cardTags = (card as HTMLElement).dataset.tags.split(',');
          
          let isVisible = false;

          if (value === 'all') {
            isVisible = true;
          } else if (filterType === 'category') {
            isVisible = cardCat === value;
          } else if (filterType === 'tag') {
            isVisible = cardTags.includes(value);
          }

          if (isVisible) {
            (card as HTMLElement).style.display = 'block';
            (card as HTMLElement).classList.add('animate-fade-in');
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      }

      // 綁定事件
      categoryBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
            const val = (e.target as HTMLElement).dataset.value;
            filterProjects('category', val);
        });
      });

      tagBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
            const val = (e.target as HTMLElement).dataset.value;
            filterProjects('tag', val);
        });
      });
    </script>
  </body>
</html>